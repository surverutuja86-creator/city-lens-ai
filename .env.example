# CityLens AI v3 — production-safe environment template
# Copy to .env for local development. Never commit real secret values.

PORT=4000
NODE_ENV=development

# Production authentication secret (REQUIRED on Vercel / NODE_ENV=production).
# Use a long cryptographically random value. Keep stable across deployments.
AUTH_SECRET=

# Neon PostgreSQL connection string. When absent, local development uses
# data/citylens.json. Vercel production should always configure DATABASE_URL.
DATABASE_URL=

# Vercel Blob persistent evidence/upload storage. New Vercel projects can use
# request-scoped OIDC with no long-lived token. Keep this blank for OIDC; set it
# only for a legacy/static-token Blob connection or local tooling that needs it.
BLOB_READ_WRITE_TOKEN=
# Private is recommended for repair/user-uploaded evidence.
BLOB_ACCESS=private

# Optional external inference adapter. Blank means truthfully Not Configured.
YOLO_SERVICE_URL=

# Backward-compatible alias; AUTH_SECRET takes precedence.
CITYLENS_SECRET=

# Optional first production admin. Unlike local development, production does
# NOT create known-password demo accounts automatically.
BOOTSTRAP_ADMIN_NAME=CityLens Admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional local/testing override only. Do not use as production persistence.
CITYLENS_DATA_DIR=
